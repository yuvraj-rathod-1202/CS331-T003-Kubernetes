# Build the per-node IPAM agent
FROM golang:1.26 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o ipam-agent cmd/ipam-agent/main.go

# The agent writes under /etc/cni/net.d and installs routes, so it runs as root
# in a privileged hostNetwork pod; see deploy/ipam-agent.yaml.
# busybox, not distroless: the agent runs nsenter to use the host's iptables.
FROM busybox:1.36
WORKDIR /
COPY --from=builder /workspace/ipam-agent .
USER 0:0
ENTRYPOINT ["/ipam-agent"]
